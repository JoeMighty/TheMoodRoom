rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for The Mood Room Art Exhibition
    match /exhibitThoughts/{document} {
      // Allow anyone to submit thoughts and read them in real-time
      allow read, write: if true;
      
      // Optional: If you want to limit access after the exhibition, 
      // you can replace the rule above with a date limit (e.g. until July 31, 2026):
      // allow read, write: if request.time < timestamp.date(2026, 7, 31);
    }
  }
}
